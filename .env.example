# PostgreSQL — produção (integração Supabase + Vercel injeta POSTGRES_URL automaticamente)
POSTGRES_URL=

# Desenvolvimento local — alternativa a POSTGRES_URL (ex.: PostgreSQL local ou Supabase)
DATABASE_URL=

# Obrigatório em produção — segredo para cookies de sessão (string aleatória longa)
SESSION_SECRET=

# Opcional — criptografia dos refresh tokens do Google (se omitido, usa SESSION_SECRET)
GOOGLE_TOKEN_SECRET=

# Opcional — Google Calendar / Meet (agendamentos locais funcionam sem isso)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Apenas CLI local — npm run create-admin (não configurar na Vercel)
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# URL pública do CRM (webhook API4COM e links absolutos)
NEXT_PUBLIC_APP_URL=

# API4COM — preferir variáveis na Vercel; alternativa: Admin → Variáveis (categoria API4COM)
# API4COM_API_TOKEN=
# API4COM_GATEWAY=inlift-crm
# API4COM_WEBHOOK_SECRET=
# API4COM_BASE_URL=https://api.api4com.com

# Node (Vercel define automaticamente em produção)
# NODE_ENV=production
